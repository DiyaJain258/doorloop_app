      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f155f302-3b4e-452f-b3c4-842f2f71695d"
      }
    },
    "owner": "essence-divine"
